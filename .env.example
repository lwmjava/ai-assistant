# 配置标注：选填表示源码提供默认值；条件必填表示生产或选择相应能力时需要配置。
# 标注描述使用要求，不承诺启动时自动校验全部条件；解析成功不代表生产或外部服务可用。
# 每个Settings字段恰有一个有效键；Compose专用端口仅在下方以注释说明。

# ai-assistant
# 复制为 .env 后填写；真实密钥只放在本地 .env（已被 .gitignore 忽略）。

# ── 应用 ──
# 运行环境：development | production。生产环境强制校验安全配置。
# [选填] ENV
ENV=development
# [选填] DEBUG
DEBUG=false
# [选填] APP_NAME
APP_NAME=ai-assistant
# [选填] APP_VERSION
APP_VERSION=0.1.0

# 是否由本进程托管 frontend/dist 构建产物（单进程同时提供 API 与 Web 控制台）。
# 开启后 GET / 返回前端入口，其余非 API 路径回退给前端路由；/api/* 行为不变。
# 需先在 frontend/ 下执行 npm run build。默认关闭以保持 GET / 的 JSON 契约。
# [选填] SERVE_FRONTEND
SERVE_FRONTEND=false

# ── 数据库 ──
# 本地开发默认 SQLite；生产建议 PostgreSQL。
# 示例：postgresql://aiassistant:aiassistant@localhost:5432/aiassistant
# [选填] DATABASE_URL
DATABASE_URL=sqlite:///./data/ai_assistant.db
# [选填] DB_ECHO
DB_ECHO=false

# ── 安全 / JWT ──
# 编排启动前必须换成随机密钥。留空或沿用仓库内占位口令时，不能当作已配置。
# [条件必填] JWT_SECRET_KEY：生产/Compose必须填写随机密钥；空值不代表安全已配置
JWT_SECRET_KEY=
# [选填] JWT_ALGORITHM
JWT_ALGORITHM=HS256
# [选填] ACCESS_TOKEN_EXPIRE_MINUTES
ACCESS_TOKEN_EXPIRE_MINUTES=30
# [选填] REFRESH_TOKEN_EXPIRE_DAYS
REFRESH_TOKEN_EXPIRE_DAYS=7
# 是否启用认证（演示/调试可临时关闭，生产必须开启）
# [选填] AUTH_ENABLED
AUTH_ENABLED=true
# 对话限流。默认关闭，计数只在本进程，重启即清空。
# 页面验收可临时改为 SECURITY_RATE_LIMIT=true、CAPACITY=1、RATE=0.2，第二条大约等 5 秒。
# [选填] SECURITY_RATE_LIMIT
SECURITY_RATE_LIMIT=false
# [选填] SECURITY_RATE_LIMIT_CAPACITY
SECURITY_RATE_LIMIT_CAPACITY=60
# [选填] SECURITY_RATE_LIMIT_RATE
SECURITY_RATE_LIMIT_RATE=60

# ── 初始管理员（仅用于首次引导，建议在创建后删除或仅开发环境使用）──
# 若设置，且库中无任何用户，启动时会创建该 system_admin 账号。
# [条件必填] INITIAL_ADMIN_USERNAME：选择首次管理员自动引导时与PASSWORD同时配置；不启用可留空
INITIAL_ADMIN_USERNAME=admin
# [条件必填] INITIAL_ADMIN_PASSWORD：留空占位；选择首次管理员自动引导时与USERNAME同时配置，在本地或秘密管理中填写自主口令，勿提交仓库
INITIAL_ADMIN_PASSWORD=
# [选填] INITIAL_ADMIN_EMAIL
INITIAL_ADMIN_EMAIL=admin@example.com
# [条件必填] 启用三账号引导时，以下两项与管理员口令同时配置，管理员用户名必须为 admin
# 各账号使用独立口令；留空保留旧版单管理员引导，不写入真实口令
# [条件必填] INITIAL_SYSTEM_PASSWORD：三账号引导时与管理员及culture口令同时配置，否则留空
INITIAL_SYSTEM_PASSWORD=
# [条件必填] INITIAL_CULTURE_PASSWORD：三账号引导时与管理员及system口令同时配置，否则留空
INITIAL_CULTURE_PASSWORD=

# ── CORS ──
# 逗号分隔的允许来源；生产环境必须显式指定，禁止使用 *
# [条件必填] CORS_ORIGINS：本地仅允许下列来源，生产必须替换为实际 HTTPS 前端来源
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── 服务器 ──
# [选填] HOST
HOST=0.0.0.0
# [选填] PORT
PORT=8000
# [选填] LOG_LEVEL
LOG_LEVEL=INFO
# [选填] LOG_FILE：相对项目根目录。本地与容器都写入该文件，按大小滚动。
LOG_FILE=logs/app.log

# ── LLM 提供商 ──
# 提供商：openai | ollama | mock
#   openai  → OpenAI 官方接口
#   ollama  → 本地 Ollama 的 /v1 兼容接口（把 LLM_BASE_URL 改为 http://localhost:11434/v1）
#   mock    → 离线占位模型，不连接真实服务（适合本地开发与测试）
# [选填] LLM_PROVIDER
LLM_PROVIDER=openai
# [选填] LLM_BASE_URL
LLM_BASE_URL=https://api.openai.com/v1
# 编排启动前必须填写一个模型密钥。留空时 docker compose config 会失败。
# 本地开发且 ENV=development 时，主密钥和兜底密钥都为空会降级为 mock，对话页提示填写密钥并重启。
# [条件必填] LLM_API_KEY：使用真实主模型时填写；无可用密钥的开发环境会降级Mock
LLM_API_KEY=
# [选填] LLM_DEFAULT_MODEL
LLM_DEFAULT_MODEL=gpt-4o-mini
# 生成参数
# [选填] LLM_TEMPERATURE
LLM_TEMPERATURE=0.7
# Optional process caches: authenticated scope + data/index/context identity required.
# LLM cache additionally requires explicit temperature=0 and verified complete response.
# [选填] RETRIEVAL_CACHE_ENABLED
RETRIEVAL_CACHE_ENABLED=false
# [选填] LLM_RESPONSE_CACHE_ENABLED
LLM_RESPONSE_CACHE_ENABLED=false
# [选填] CACHE_TTL_SECONDS
CACHE_TTL_SECONDS=60
# [选填] CACHE_MAX_ENTRIES
CACHE_MAX_ENTRIES=256
# [选填] CACHE_MAX_BYTES
CACHE_MAX_BYTES=8388608
# [选填] CACHE_MAX_ENTRY_BYTES
CACHE_MAX_ENTRY_BYTES=262144
# [选填] LLM_MAX_TOKENS
LLM_MAX_TOKENS=2048
# [选填] LLM_TIMEOUT
LLM_TIMEOUT=60.0
# 第二家。密钥留空表示没有兜底，行为与只配上面这一套相同。
# [选填] LLM_FALLBACK_PROVIDER
LLM_FALLBACK_PROVIDER=openai
# [选填] LLM_FALLBACK_BASE_URL
LLM_FALLBACK_BASE_URL=
# [条件必填] LLM_FALLBACK_API_KEY：需要启用独立兜底服务时填写，不使用可留空
LLM_FALLBACK_API_KEY=
# [选填] LLM_FALLBACK_MODEL
LLM_FALLBACK_MODEL=
# 意图分流。密钥留空表示和对话用同一家。
# [选填] LLM_INTENT_PROVIDER
LLM_INTENT_PROVIDER=
# [选填] LLM_INTENT_BASE_URL
LLM_INTENT_BASE_URL=
# [条件必填] LLM_INTENT_API_KEY：需要独立意图服务时填写，否则按既有链复用主服务
LLM_INTENT_API_KEY=
# [选填] LLM_INTENT_MODEL
LLM_INTENT_MODEL=
# 失败后的尝试顺序，只认 chat、intent、fallback。
# [选填] LLM_CHAT_FALLBACK_CHAIN
LLM_CHAT_FALLBACK_CHAIN=chat,fallback
# [选填] LLM_INTENT_FALLBACK_CHAIN
LLM_INTENT_FALLBACK_CHAIN=intent,chat,fallback
# 进程内瞬时故障熔断：跨工厂实例计数；取消、参数/预算、401/403不累计故障。
# [选填] LLM_CIRCUIT_FAILURE_THRESHOLD：连续瞬时失败阈值
LLM_CIRCUIT_FAILURE_THRESHOLD=3
# [选填] LLM_CIRCUIT_COOLDOWN_SECONDS：开路后冷却时间，期满仅允许一次半开探测
LLM_CIRCUIT_COOLDOWN_SECONDS=30
# 重排仅登记独立任务配置，当前不启用检索重排，也不调用chat/completions代替重排。
# [选填] LLM_RERANK_PROVIDER
LLM_RERANK_PROVIDER=
# [选填] LLM_RERANK_BASE_URL
LLM_RERANK_BASE_URL=
# [选填] LLM_RERANK_MODEL
LLM_RERANK_MODEL=
# [条件必填] LLM_RERANK_API_KEY：保留环境注入占位；配置存在不代表已启用执行
LLM_RERANK_API_KEY=
# ── 模型能力契约与调用预算（RAG-028）──
# 护栏在**每次真实请求发出前**核对：实际 payload + 输出预留 + 余量 ≤ 已登记的上下文窗口。
# payload 用本次真正要发的 messages 现算，工具返回与自纠错轮次因此天然被计入。
# 计数优先用厂商官方计数器；官方计数器不可用时退回「UTF-8 字节数」保守估算
# （字节数一般 ≥ token 数，因此偏保守，不是精确 tokenizer 输出），并把所用方法写进能力契约。
# 只在 OpenAI 官方域名下认 tiktoken；装上 tiktoken 后会自动优先使用官方计数器，无需改代码。
# [选填] LLM_CAPABILITY_GUARD_ENABLED
LLM_CAPABILITY_GUARD_ENABLED=true
# 未知模型没有已批准的能力配置时**拒绝调用**。要放行必须由运营者显式声明：
# 格式 部署!模型=窗口:最大输出，多项用逗号分隔。部署可省略 scheme，
# 例：gateway.internal/v1!my-model=32768:4096
# 声明**按部署+模型生效**：省略部署时只对 LLM_BASE_URL 对应的主部署生效，
# intent / fallback 指向别的端点时不借用。窗口与最大输出必须是正整数、
# 最大输出不超过窗口，且不超过合理上界（窗口 2000000、输出 400000），越界按未批准处理。
# [条件必填] LLM_CAPABILITY_DECLARED：护栏开启且模型能力未登记时，填写已核验声明并同时提供来源
LLM_CAPABILITY_DECLARED=
# 上面那条声明的依据来源（厂商文档 URL 或内部文档名）。
# 声明与来源必须同时填写，缺一项即视为未批准——数值由运营者给，不由代码猜。
# [条件必填] LLM_CAPABILITY_DECLARED_SOURCE：使用显式能力声明时同时填写依据来源
LLM_CAPABILITY_DECLARED_SOURCE=
# 预算余量，覆盖消息框架、工具描述等计数误差
# [选填] LLM_BUDGET_SAFETY_MARGIN
LLM_BUDGET_SAFETY_MARGIN=512
# 未显式给出 max_tokens 时，按此值预留输出
# [选填] LLM_OUTPUT_RESERVE_TOKENS
LLM_OUTPUT_RESERVE_TOKENS=2048
# 注意：仓库默认模型 deepseek-chat 已不在厂商在售模型表内，各来源数字互相矛盾，
# 因此本仓库**没有**登记它的能力。继续使用它必须先在上面两行显式声明窗口、
# 最大输出与依据来源，否则护栏会拒绝调用（不是报错，而是拒绝发出请求）。
# 云 OCR（RAG_OCR_PROVIDER=cloud）送的是 base64 图片，同样在这一套预算之内：
# 它回落到 LLM_BASE_URL / LLM_DEFAULT_MODEL，所以也需要上面的声明。

# ── 嵌入模型（RAG 检索）──
# 是否将检索上下文注入对话管线（开启后 /api/chat 会自动检索知识库）
# [选填] RAG_ENABLED
RAG_ENABLED=true
# 嵌入提供商：openai | ollama | mock（与 LLM 共用 OpenAI 兼容 /embeddings 协议）
# 默认使用阿里通义千问（DashScope 兼容模式）；DeepSeek 不提供嵌入接口，故向量模型可与对话模型不同厂商
# [选填] EMBEDDING_PROVIDER
EMBEDDING_PROVIDER=openai
# [选填] EMBEDDING_BASE_URL
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 嵌入 API Key 通过环境变量注入；为空且为开发环境时自动降级为 mock（哈希词袋）
# [条件必填] EMBEDDING_API_KEY：生产真实Embedding需要密钥；开发空值只证明Mock链路
EMBEDDING_API_KEY=
# [选填] EMBEDDING_MODEL
EMBEDDING_MODEL=text-embedding-v3
# 必须与模型实际返回维度一致：text-embedding-v3 默认 1024（可选 1024/768/512）
# [选填] EMBEDDING_DIM
EMBEDDING_DIM=1024
# 单次嵌入请求的文本条数。DashScope text-embedding-v3/v4 上限为 10，超过会 400。
# [选填] EMBEDDING_BATCH_SIZE
EMBEDDING_BATCH_SIZE=10
# 单次嵌入 HTTP 超时（秒）。嵌入是短请求，不复用 LLM 对话超时。
# 检索路径下实际生效值会被共享总时限夹住；写入 / 导入 / 重建索引 / 语义切分
# 同样使用这个超时（同一个 provider），只被 RAG_EMBED_BATCH_DEADLINE_SECONDS 夹住。
# [选填] EMBEDDING_TIMEOUT_SECONDS
EMBEDDING_TIMEOUT_SECONDS=15.0
# 索引身份：模型 / 维度 / 归一化 / 度量任一变化都要换索引，不能原地混写。
# 换模型时递增 EMBEDDING_INDEX_VERSION 并走 scripts/rebuild_embedding_index.py 重建后切换。
# [选填] EMBEDDING_INDEX_VERSION
EMBEDDING_INDEX_VERSION=1
# 归一化与度量：当前实现只按 l2 归一化 + cosine 度量执行，配置其它值会在索引身份
# 构造时直接报错（摄取与检索一起失败）。要支持别的值，先实现对应行为再放开注释。
# [选填] EMBEDDING_NORMALIZATION
EMBEDDING_NORMALIZATION=l2
# [选填] EMBEDDING_METRIC
EMBEDDING_METRIC=cosine

# ── 向量库与检索 ──
# 默认必须保持 local。切到 milvus 前先运行 scripts/milvus_switch_check.py 查看计划，
# 再显式加 --apply 做真实验收；回切只改回 local，不删除任一后端已有数据。
# 向量库后端：local（SQLite + numpy，零额外依赖）| milvus（需额外安装 pymilvus）
# [选填] RAG_VECTOR_STORE：默认 milvus。local 只用于显式离线评测或隔离测试。
RAG_VECTOR_STORE=milvus
# 单实例导入：每轮批次数与进程内所有执行入口共用的并发上限分别控制（1..1000）。
# [选填] RAG_IMPORT_ENABLED
RAG_IMPORT_ENABLED=true
# [选填] RAG_IMPORT_INTERVAL_SECONDS
RAG_IMPORT_INTERVAL_SECONDS=3.0
# [选填] RAG_IMPORT_FETCH_TIMEOUT
RAG_IMPORT_FETCH_TIMEOUT=30.0
# [选填] RAG_IMPORT_BATCH_SIZE
RAG_IMPORT_BATCH_SIZE=2
# [选填] RAG_IMPORT_MAX_CONCURRENCY
RAG_IMPORT_MAX_CONCURRENCY=2
# 单文件上传上限（字节）。默认 10485760（10 MiB）。等于上限可以上传。
# [选填] RAG_UPLOAD_MAX_BYTES
RAG_UPLOAD_MAX_BYTES=10485760
# 允许的扩展名，逗号分隔，不带点。只看最后一个后缀。
# [选填] RAG_UPLOAD_ALLOWED_EXTENSIONS
RAG_UPLOAD_ALLOWED_EXTENSIONS=txt,md,json,xml,csv,doc,xls,ppt,docx,xlsx,pptx,pdf
# [选填] RAG_CHUNK_SIZE
RAG_CHUNK_SIZE=500        # 分块字符数上限
# [选填] RAG_CHUNK_OVERLAP
RAG_CHUNK_OVERLAP=64      # 分块重叠字符数
# ── 文档切分策略 ──
# structured（默认，Markdown 结构）/ paragraph / sliding_window / token_aware / semantic / parent_child / auto
# [选填] RAG_CHUNK_STRATEGY
RAG_CHUNK_STRATEGY=structured
# ── RAG-031 LLM 辅助切分边界（默认关闭）──
# 结构保护之后，让 LLM 只对正文间隙建议「句子序号」，代码按序号切取原文；
# 坏 JSON / 注入 / 超时 / 调用超限一律规则降级，不改写原文、不阻塞摄取。
# [选填] RAG_LLM_BOUNDARY_ENABLED
RAG_LLM_BOUNDARY_ENABLED=false
# [选填] RAG_LLM_BOUNDARY_MAX_CHARS
RAG_LLM_BOUNDARY_MAX_CHARS=1500        # 单次发给模型的正文上限（字符），超过则不调用、规则切分
# [选填] RAG_LLM_BOUNDARY_MAX_CALLS
RAG_LLM_BOUNDARY_MAX_CALLS=3           # 单篇文档最多几次边界建议调用（费用护栏）
# [选填] RAG_LLM_BOUNDARY_MAX_OUTPUT_TOKENS
RAG_LLM_BOUNDARY_MAX_OUTPUT_TOKENS=256 # 输出预留 token（进 RAG-028 上下文预算）
# [选填] RAG_LLM_BOUNDARY_TIMEOUT_SECONDS
RAG_LLM_BOUNDARY_TIMEOUT_SECONDS=15.0  # 单次边界建议调用超时（秒）
# RAG-040 章节摘要（版本绑定的派生数据；默认关闭，不进向量检索、不替代原文块）。
# [选填] RAG_SECTION_SUMMARY_ENABLED
RAG_SECTION_SUMMARY_ENABLED=false
# [选填] RAG_SECTION_SUMMARY_MAX_CALLS
RAG_SECTION_SUMMARY_MAX_CALLS=8                 # 单任务最多几次摘要调用（费用护栏）
# [选填] RAG_SECTION_SUMMARY_MAX_CHARS_PER_BATCH
RAG_SECTION_SUMMARY_MAX_CHARS_PER_BATCH=4000    # 单批正文上限，超过切批逐批摘要后合并
# [选填] RAG_SECTION_SUMMARY_MAX_OUTPUT_TOKENS
RAG_SECTION_SUMMARY_MAX_OUTPUT_TOKENS=256       # 单条摘要输出预留 token
# [选填] RAG_SECTION_SUMMARY_TIMEOUT_SECONDS
RAG_SECTION_SUMMARY_TIMEOUT_SECONDS=20.0        # 单次摘要调用超时（秒）
# [选填] RAG_TOP_K
RAG_TOP_K=5               # 每次检索返回的最大块数
# [选填] RAG_MIN_SIMILARITY
RAG_MIN_SIMILARITY=0.4    # 稠密相似度低于该值可少返回或全不返回
# [选填] RAG_HYBRID_RRF_K
RAG_HYBRID_RRF_K=60       # 倒数排名融合（RRF）常数 k
# [选填] RAG_RETRIEVAL_CANDIDATE_MULTIPLIER
RAG_RETRIEVAL_CANDIDATE_MULTIPLIER=3  # 过取倍数，供注入块剔除后补位
# [选填] RAG_DROP_INJECTED_CHUNKS
RAG_DROP_INJECTED_CHUNKS=true         # 检索后剔除高置信度注入分块
# [选填] RAG_KB_SCOPE
RAG_KB_SCOPE=tenant                   # tenant=同租户当前版本；uploader=回滚上传者私有
# [选填] RAG_MEMORY_CONTEXT_CHARS
RAG_MEMORY_CONTEXT_CHARS=2000         # 注入管线的记忆字符预算
# [选填] RAG_CONTEXT_CHARS
RAG_CONTEXT_CHARS=6000                # 注入管线的 RAG 字符预算
# [选填] RAG_EFFECTIVE_DATE_FILTER
RAG_EFFECTIVE_DATE_FILTER=false       # ADR-0003：按生效日期过滤；默认关闭保持现网
# ── 检索调用韧性（RAG-038）：总时限 + 有限退避 + 取消传播 ──
# 一次检索 = 嵌入 + 向量检索，两者共用这一个总预算，不是各起一个超时。
# 依赖方抖动时宁可「体面失败 + 明确披露」，也不要把整个对话请求拖死。
# [选填] RAG_RETRIEVAL_RESILIENCE_ENABLED
RAG_RETRIEVAL_RESILIENCE_ENABLED=true   # 总开关；休眠/无网排障时可置 false 关掉重试
# [选填] RAG_RETRIEVAL_DEADLINE_SECONDS
RAG_RETRIEVAL_DEADLINE_SECONDS=8.0      # 总时限（秒）；0 或负数 = 关闭时限与重试
# [选填] RAG_RETRIEVAL_MAX_ATTEMPTS
RAG_RETRIEVAL_MAX_ATTEMPTS=3            # 单个子调用最多打几次（含首次）；只对连接错误/读超时/429/5xx 重试
# [选填] RAG_RETRIEVAL_BACKOFF_BASE_SECONDS
RAG_RETRIEVAL_BACKOFF_BASE_SECONDS=0.2  # 退避基数：第 n 次失败等 base * 2**(n-1)
                                        # base<=0 = 零退避：失败后立即重试（不等），不是禁用
# [选填] RAG_RETRIEVAL_BACKOFF_MAX_SECONDS
RAG_RETRIEVAL_BACKOFF_MAX_SECONDS=1.5   # 退避上限：单次等待不超过它，且预算不够时直接放弃不等待
# ⚠️ 约束：DEADLINE 必须**严格大于** min(BASE, MAX) * 1.2，否则第一次失败后剩余
# 预算就不够等退避了，一次重试都不会发生（启动会告警「重试实际已禁用」）。
# base<=0 时退避为 0、立即重试，本约束自动满足（不算「重试实际已禁用」）。
# [选填] RAG_EMBED_BATCH_DEADLINE_SECONDS
RAG_EMBED_BATCH_DEADLINE_SECONDS=20.0   # 嵌入**单批**的写入侧预算（秒）
                                        # 未绑定检索 deadline 时（导入 / 重建索引 / 语义切分）
                                        # 每批各拿一个，不复用上面的检索总时限；0 = 不限时
# RAG 切分/检索策略：native（自研，默认）| langchain | llamaindex
# [选填] RAG_BACKEND
RAG_BACKEND=native
# LangChain 切分器类型（当前仅 recursive；需 pip install "ai-assistant[langchain]"）
# [选填] RAG_LANGCHAIN_SPLITTER
RAG_LANGCHAIN_SPLITTER=recursive
# LlamaIndex NodeParser：sentence | markdown（需 pip install "ai-assistant[llamaindex]"）
# [选填] RAG_LLAMAINDEX_SPLITTER
RAG_LLAMAINDEX_SPLITTER=sentence

# ── OCR（扫描版 PDF）──
# 关闭时，扫描版 PDF 会因“需要 OCR”而导入失败；带文本层的 PDF 不受影响。
# [选填] RAG_OCR_ENABLED
RAG_OCR_ENABLED=false
# provider：tesseract | cloud
# [选填] RAG_OCR_PROVIDER
RAG_OCR_PROVIDER=tesseract
# 本地 Tesseract 使用的语言包，当前默认中文简体 + 英文。
# [选填] RAG_OCR_LANGUAGES
RAG_OCR_LANGUAGES=chi_sim+eng
# 单次 OCR 处理超时（秒）。
# [选填] RAG_OCR_TIMEOUT_SECONDS
RAG_OCR_TIMEOUT_SECONDS=60.0
# 云 OCR 专用配置：若三项都为空，则回退到上面的 LLM_BASE_URL / LLM_API_KEY / LLM_DEFAULT_MODEL。
# [选填] RAG_OCR_BASE_URL
RAG_OCR_BASE_URL=
# [条件必填] RAG_OCR_API_KEY：云OCR需要有效密钥，可按既有回退规则使用主LLM密钥
RAG_OCR_API_KEY=
# [选填] RAG_OCR_MODEL
RAG_OCR_MODEL=

# ── 老 Office（doc / xls / ppt）──
# .xls 使用纯 Python 的 xlrd 解析；.doc/.ppt 需要 LibreOffice（soffice）做 headless 转换后再解析。
# 若服务器未安装 LibreOffice，.doc/.ppt 导入任务会失败并记录明确错误原因。

# ── Agent 工具调用（Function Calling）──
# 「行动」阶段单次对话最多执行的工具调用次数（PRD §5.1.3=10），范围 1~100；
# 达到上限后停止工具行动，并在最终回复中说明因预算耗尽而停止。
# [选填] AGENT_MAX_TOOL_ROUNDS
AGENT_MAX_TOOL_ROUNDS=10
# [选填] AGENT_STATE_PERSIST_ENABLED
AGENT_STATE_PERSIST_ENABLED=true
# [选填] AGENT_STATE_TTL_SECONDS
AGENT_STATE_TTL_SECONDS=604800
# [选填] AGENT_STATE_CHECKPOINT_TOOL_ROUND
AGENT_STATE_CHECKPOINT_TOOL_ROUND=true

# ── Agent 编排与质量 ──
# 编排实现：self（自研五阶段管线，默认）| langgraph（LangGraph Supervisor 子编排）
# LangGraph 仅覆盖「多 Agent 协作」一层，由本开关切换，不影响自研路径。
# [选填] AGENT_ORCHESTRATION
AGENT_ORCHESTRATION=self
# 质量门：低于阈值触发「行动」自纠错（默认关闭；如需启用改为 true）
# [选填] AGENT_QUALITY_GATE_ENABLED
AGENT_QUALITY_GATE_ENABLED=false
# [选填] AGENT_QUALITY_THRESHOLD
AGENT_QUALITY_THRESHOLD=0.6   # 质量门合格阈值（0~1）
# [选填] AGENT_MAX_REVISIONS
AGENT_MAX_REVISIONS=2         # 「行动」草稿不合格时的最大自纠错轮数

# ── MCP 客户端 ──
# 默认关闭。改为 true 后，对话会尝试连接 MCP_SERVERS 里的服务器并把其工具注入工具箱。
# 未启用时，GET /api/mcp/tools 返回 503。
# [选填] MCP_ENABLED
MCP_ENABLED=false
# JSON 数组。transport 取 stdio、http 或 sse。密钥放在 env 或 headers 里，不要写进仓库。
# 示例：[{"name":"crm","transport":"http","url":"http://localhost:9000/mcp"}]
# [选填] MCP_SERVERS
MCP_SERVERS=

# ── 工作流引擎 ──
# 默认关闭。改为 true 后才提供工作流接口和定时调度。
# 未启用时，GET /api/workflows 返回 503。
# [选填] WORKFLOW_ENABLED
WORKFLOW_ENABLED=false
# [选填] 全进程 manual/cron 共享并发上限，整数 1..1000；满容量拒绝，不排队。
WORKFLOW_MAX_CONCURRENCY=4

# 零费用评测任务执行器。真实模型模式仍需另行预算授权。
EVALUATION_JOB_MAX_CONCURRENCY=1
EVALUATION_JOB_TIMEOUT_SECONDS=900

# 真实 RAG 生成/Judge：复用 LLM_BASE_URL / LLM_API_KEY / LLM_DEFAULT_MODEL。
# 默认关闭。配置完整价格身份/来源与最高单价后方可启用；不要填写示意价格。
EVALUATION_QUALITY_ENABLED=false
EVALUATION_PRICE_BASE_URL=
EVALUATION_PRICE_MODEL=
EVALUATION_PRICE_REFERENCE=
# 单位为元/百万 tokens，均须正数；未配置时拒绝质量任务。
# EVALUATION_INPUT_YUAN_PER_MTOK=<核验后的最高输入单价>
# EVALUATION_OUTPUT_YUAN_PER_MTOK=<核验后的最高输出单价>
# 检索的 Embedding 共享同一调用/费用上限，沿用现有 EMBEDDING_* 服务。
EVALUATION_EMBEDDING_PRICE_BASE_URL=
EVALUATION_EMBEDDING_PRICE_MODEL=
EVALUATION_EMBEDDING_PRICE_REFERENCE=
# EVALUATION_EMBEDDING_YUAN_PER_MTOK=<核验后的最高嵌入单价>
RUN_HISTORY_RETENTION_DAYS=30
RUN_HISTORY_MAX_EVENTS=200
MEMORY_SNAPSHOT_RETENTION_DAYS=30

# ── Milvus（仅当 RAG_VECTOR_STORE=milvus 时使用）──
# docker compose 暴露的 gRPC 与健康检查端口；应用容器内仍通过 milvus:19530 连接。
# Compose专用覆盖（非Settings字段）：MILVUS_PORT=19530；省略时编排采用相同默认端口。
# Compose专用覆盖（非Settings字段）：MILVUS_HEALTH_PORT=9091；省略时编排采用相同默认端口。
# [选填] MILVUS_URI
MILVUS_URI=http://localhost:19530
# 开发环境启动时，仅本机地址连不上才使用 Lite 文件。生产环境不会兜底。
MILVUS_LITE_FALLBACK=true
MILVUS_LITE_PATH=data/milvus-lite/dev.db
# [选填] MILVUS_TOKEN
MILVUS_TOKEN=
# [选填] MILVUS_COLLECTION
MILVUS_COLLECTION=ai_assistant_chunks
# [选填] MILVUS_INDEX_TYPE
MILVUS_INDEX_TYPE=AUTOINDEX  # 向量索引类型，IVF_* 时检索参数带 nprobe
# [选填] MILVUS_NPROBE
MILVUS_NPROBE=16             # IVF_* 索引的查询聚类数，仅对该类索引生效

# 国内联网搜索：缺少所选密钥时不注册工具，/api/health 报 unavailable。
# dashscope | zhipu | bocha | baidu | disabled；不会回退到国外服务。
# [选填] SEARCH_PROVIDER
SEARCH_PROVIDER=dashscope
# [条件必填] SEARCH_DASHSCOPE_API_KEY：使用对应搜索提供商时填写；未配置时该工具不可用
SEARCH_DASHSCOPE_API_KEY=
# [条件必填] SEARCH_ZHIPU_API_KEY：使用对应搜索提供商时填写；未配置时该工具不可用
SEARCH_ZHIPU_API_KEY=
# [条件必填] SEARCH_BOCHA_API_KEY：使用对应搜索提供商时填写；未配置时该工具不可用
SEARCH_BOCHA_API_KEY=
# [条件必填] SEARCH_BAIDU_API_KEY：使用对应搜索提供商时填写；未配置时该工具不可用
SEARCH_BAIDU_API_KEY=
# [选填] SEARCH_DASHSCOPE_MODEL
SEARCH_DASHSCOPE_MODEL=qwen-plus
# [选填] SEARCH_ZHIPU_MODEL
SEARCH_ZHIPU_MODEL=web-search-pro
# [选填] SEARCH_BAIDU_MODEL
SEARCH_BAIDU_MODEL=ernie-4.5-turbo-32k
# [选填] SEARCH_TIMEOUT_SECONDS
SEARCH_TIMEOUT_SECONDS=15
# [选填] SEARCH_MAX_RESULTS
SEARCH_MAX_RESULTS=5
# [选填] SEARCH_MAX_RESPONSE_BYTES
SEARCH_MAX_RESPONSE_BYTES=1048576

# 默认禁用。仅由运维明确授权公开共享文本根，不可填租户上传、数据库或配置目录。
# JSON 别名->绝对路径；工具输入只有别名和相对路径，health 不展示主机路径。
# [选填] FILE_OPS_ENABLED
FILE_OPS_ENABLED=false
# [选填] FILE_OPS_ALLOWED_ROOTS
FILE_OPS_ALLOWED_ROOTS={}
# [选填] FILE_OPS_MAX_BYTES
FILE_OPS_MAX_BYTES=65536

# ── 当前Settings缺项补齐：值沿用源码默认，不新增能力或改变业务行为 ──
# [选填] RAG_REFUSE_MESSAGE
RAG_REFUSE_MESSAGE="未检索到足够相关的知识库资料，未能给出可靠答案。请补充关键词，或确认相关资料已上传至知识库。"
# [选填] RAG_STATUS_NOTICE_ENABLED
RAG_STATUS_NOTICE_ENABLED=true
# [选填] RAG_NO_HIT_NOTICE
RAG_NO_HIT_NOTICE="知识库中没有检索到与问题相关的资料。本次回答未使用知识库内容，属于模型自身知识，不能当作知识库结论引用。"
# [选填] RAG_UNAVAILABLE_NOTICE
RAG_UNAVAILABLE_NOTICE="知识库检索服务当前不可用，本次没有取得任何知识库资料。必须明确告知用户检索失败，不得把模型自身知识包装成知识库结论。"
# [选填] RAG_NO_HIT_REPLY
RAG_NO_HIT_REPLY="【提示】知识库中没有检索到相关资料，以下回答基于模型自身知识，不是知识库结论。"
# [选填] RAG_UNAVAILABLE_REPLY
RAG_UNAVAILABLE_REPLY="【提示】知识库检索服务当前不可用，以下回答不含知识库内容。"
# [选填] SKILL_ENABLED
SKILL_ENABLED=true
# [选填] SKILL_DIRS
SKILL_DIRS=""
# [选填] MEMORY_ENABLED
MEMORY_ENABLED=true
# [选填] MEMORY_WINDOW_SIZE
MEMORY_WINDOW_SIZE=20
# [选填] MEMORY_COMPRESSION_THRESHOLD
MEMORY_COMPRESSION_THRESHOLD=30
# [选填] MEMORY_STRATEGY
MEMORY_STRATEGY="summary"
# [选填] MEMORY_MAX_SUMMARY_CHARS
MEMORY_MAX_SUMMARY_CHARS=2000
# [选填] MEMORY_KEEP_RECENT
MEMORY_KEEP_RECENT=5
# [选填] AUDIT_ENABLED
AUDIT_ENABLED=true
# [选填] AUDIT_RETENTION_DAYS
AUDIT_RETENTION_DAYS=90
# [选填] EVOLUTION_ENABLED
EVOLUTION_ENABLED=false
# [选填] EVOLUTION_REFLECT_ENABLED
EVOLUTION_REFLECT_ENABLED=true
# [选填] EVOLUTION_REFLECT_ASYNC
EVOLUTION_REFLECT_ASYNC=true
# [选填] SECURITY_ENABLED
SECURITY_ENABLED=true
# [选填] SECURITY_INPUT_FILTER
SECURITY_INPUT_FILTER=true
# [选填] SECURITY_OUTPUT_FILTER
SECURITY_OUTPUT_FILTER=true
# [选填] SECURITY_INJECTION_DETECTION
SECURITY_INJECTION_DETECTION=true
# [选填] SECURITY_LOG_SANITIZE
SECURITY_LOG_SANITIZE=true
# [选填] SECURITY_INJECTION_THRESHOLD
SECURITY_INJECTION_THRESHOLD=0.5
# [选填] SECURITY_BLOCK_ON_INJECTION
SECURITY_BLOCK_ON_INJECTION=false
# [选填] DEBUG_ENABLED
DEBUG_ENABLED=false
# [选填] DEBUG_TRACE_MAX_SIZE
DEBUG_TRACE_MAX_SIZE=100
# [选填] SANDBOX_ENABLED
SANDBOX_ENABLED=true
# [选填] SANDBOX_TIMEOUT_SECONDS
SANDBOX_TIMEOUT_SECONDS=30.0
# [选填] SANDBOX_MAX_MEMORY_MB
SANDBOX_MAX_MEMORY_MB=256
# [选填] SANDBOX_MAX_CPU_SECONDS
SANDBOX_MAX_CPU_SECONDS=10
# [选填] SANDBOX_MAX_OUTPUT_CHARS
SANDBOX_MAX_OUTPUT_CHARS=100000
# [选填] SANDBOX_MAX_DISK_MB
SANDBOX_MAX_DISK_MB=50
# [选填] WORKFLOW_DEFAULT_TIMEZONE
WORKFLOW_DEFAULT_TIMEZONE="Asia/Shanghai"
# [选填] WORKFLOW_SCHEDULER_INTERVAL
WORKFLOW_SCHEDULER_INTERVAL=30.0
# [选填] WORKFLOW_MAX_EXECUTION_SECONDS
WORKFLOW_MAX_EXECUTION_SECONDS=300.0
# [选填] WORKFLOW_RETRY_MAX
WORKFLOW_RETRY_MAX=0
# [选填] WORKFLOW_RETRY_BASE_SECONDS
WORKFLOW_RETRY_BASE_SECONDS=1.0
# [选填] WORKFLOW_RETRY_MAX_DELAY_SECONDS
WORKFLOW_RETRY_MAX_DELAY_SECONDS=8.0
# [选填] EVOLUTION_DISTILL_ENABLED
EVOLUTION_DISTILL_ENABLED=false
# [选填] EVOLUTION_DISTILL_INTERVAL_SECONDS
EVOLUTION_DISTILL_INTERVAL_SECONDS=3600.0
# [选填] EVOLUTION_DISTILL_HOURS
EVOLUTION_DISTILL_HOURS=24
# [选填] EVOLUTION_DISTILL_MAX_CONVERSATIONS
EVOLUTION_DISTILL_MAX_CONVERSATIONS=50
# [选填] EVOLUTION_DISTILL_MIN_INTERVAL_HOURS
EVOLUTION_DISTILL_MIN_INTERVAL_HOURS=6
# [选填] EVOLUTION_DISTILL_WINDOW_START_HOUR
EVOLUTION_DISTILL_WINDOW_START_HOUR=2
# [选填] EVOLUTION_DISTILL_WINDOW_END_HOUR
EVOLUTION_DISTILL_WINDOW_END_HOUR=5
