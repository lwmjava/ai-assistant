# ai-assistant
# 复制为 .env 后填写；真实密钥只放在本地 .env（已被 .gitignore 忽略）。

# ── 应用 ──
# 运行环境：development | production。生产环境强制校验安全配置。
ENV=development
DEBUG=false
APP_NAME=ai-assistant
APP_VERSION=0.1.0

# ── 数据库 ──
# 本地开发默认 SQLite；生产建议 PostgreSQL。
# 示例：postgresql://aiassistant:aiassistant@localhost:5432/aiassistant
DATABASE_URL=sqlite:///./data/ai_assistant.db
DB_ECHO=false

# ── 安全 / JWT ──
# ⚠️ 生产环境必须设置为一个足够随机的密钥，否则应用启动会被拒绝。
JWT_SECRET_KEY=change-me-in-production-use-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 是否启用认证（演示/调试可临时关闭，生产必须开启）
AUTH_ENABLED=true

# ── 初始管理员（仅用于首次引导，建议在创建后删除或仅开发环境使用）──
# 若设置，且库中无任何用户，启动时会创建该 system_admin 账号。
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-admin-password
INITIAL_ADMIN_EMAIL=admin@example.com

# ── CORS ──
# 逗号分隔的允许来源；生产环境必须显式指定，禁止使用 *
CORS_ORIGINS=*

# ── 服务器 ──
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ── LLM 路由
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
# API Key 通过环境变量注入，不要写默认值
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
