{
  "id": 25052747,
  "name": "main-protection",
  "target": "branch",
  "source_type": "Repository",
  "source": "lwmjava/ai-assistant",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "exclude": [],
