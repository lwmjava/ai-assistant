{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lwmjava/ai-assistant/evals/schemas/agent_chain_case.schema.json",
  "title": "ai-assistant Agent Chain Evaluation Case",
  "description": "多轮意图分流评测。AI 编写的用例是 Silver，不是 Gold。被测模型只能看到 history 与 user_input。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "dataset_version",
    "tier",
    "synthetic",
    "history",
    "user_input",
    "expected_route",
    "critical_followup",
    "provenance",
    "tags"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^agent-[0-9]{3}$"},
    "dataset_version": {"type": "string", "const": "0.1.0"},
    "tier": {"type": "string", "const": "silver"},
    "synthetic": {"type": "boolean", "const": true},
    "history": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"type": "string", "enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "user_input": {"type": "string", "minLength": 1, "maxLength": 500},
    "expected_route": {"type": "string", "enum": ["full", "short"]},
    "expected_tools": {
      "type": "array",
      "items": {"type": "string", "enum": ["calculator", "code_sandbox", "get_current_datetime"]}
    },
    "critical_followup": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generator", "generated_at", "review_status"],
      "properties": {
        "generator": {"type": "string"},
        "generated_at": {"type": "string"},
        "review_status": {"type": "string", "const": "silver"}
      }
    },
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
